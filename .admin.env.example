# Credentials for the /admin panel (starlette-admin). Required — the API will
# not start if these are unset. Copy to .admin.env and set real values.
#
#   LLM_RADAR_ADMIN_SECRET_KEY: session-signing key, generate with
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
LLM_RADAR_ADMIN_USERNAME=admin
LLM_RADAR_ADMIN_PASSWORD=change-me
LLM_RADAR_ADMIN_SECRET_KEY=change-me-generate-a-long-random-value
